#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Ou-Mieru (For Nobrand Dual)

set -Eeuo pipefail
IFS=$'\n\t'

readonly PROJECT_NAME='Ou-Mieru (For Nobrand Dual)'
readonly PROJECT_AUTHOR='nodeseek@cshaizhihao'
readonly MIERU_VERSION='v3.36.0'
readonly MIERU_RELEASE_URL="https://github.com/enfein/mieru/releases/download/${MIERU_VERSION}"
readonly MIERU_AMD64_SHA256='44622bea7fac732984ac6cf1189e555fd9add1969001e9b2d7cdea9416b5919a'
readonly MIERU_ARM64_SHA256='a43dbc4d75dcb18978ea79b924ce859e2485af8b776dfc981b29a7b60644157c'
readonly APT_LOCK_TIMEOUT=300
readonly STATE_DIR='/etc/ou-mieru'
readonly STATE_FILE="${STATE_DIR}/install.env"
readonly CONFIG_FILE='/etc/ou-mieru/server-config.json'
readonly INSTALL_DIR='/usr/local/lib/ou-mieru'
readonly SHORTCUT_PATH='/usr/local/bin/nobrand'
readonly SELF_PATH="${BASH_SOURCE[0]:-$0}"

PORT=''
ENTRY_HOST=''
ENTRY_PORT=''
NODE_NAME='ou-mieru'
PROXY_USER=''
PROXY_PASSWORD=''
PACKAGE_OWNED=0
DRY_RUN=0
REINSTALL=0
INTERACTIVE_INSTALL=0
DETECTED_DEFAULT_IFACE=''
DETECTED_PUBLIC_IP=''
DETECTED_PRIVATE_INTERFACES=''
NETWORK_DETECTED=0

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_CYAN=$'\033[1;36m'
  C_GREEN=$'\033[1;32m'
  C_YELLOW=$'\033[1;33m'
  C_RED=$'\033[1;31m'
else
  C_RESET=''
  C_CYAN=''
  C_GREEN=''
  C_YELLOW=''
  C_RED=''
fi

banner() {
  printf '%s' "$C_CYAN"
  cat <<'EOF'
  ___  _   _       __  __ ___ _____ ____  _   _
 / _ \| | | |     |  \/  |_ _| ____|  _ \| | | |
| | | | | | |_____| |\/| || ||  _| | |_) | | | |
| |_| | |_| |_____| |  | || || |___|  _ <| |_| |
 \___/ \___/      |_|  |_|___|_____|_| \_\\___/
EOF
  printf '%s' "$C_RESET"
  printf '%s  [ O U - M I E R U ]%s\n' "$C_GREEN" "$C_RESET"
  printf '\n  %s\n  作者：%s\n\n' "$PROJECT_NAME" "$PROJECT_AUTHOR"
}

usage() {
  cat <<'EOF'
用法：
  nobrand                         打开交互式菜单。
  nobrand install --port PORT --entry-host HOST [选项]
  nobrand show                    查看已保存的 Mieru 协议和当前状态。
  nobrand uninstall [--yes]       一键卸载本项目部署。

安装选项：
  --port PORT          本机 Mieru TCP 监听端口，必填。
  --entry-host HOST    客户端使用的 L4 入口 IP 或域名，必填。
  --entry-port PORT    客户端使用的入口端口，默认等于 --port。
  --name NAME          节点名称，只允许字母、数字、点、下划线和短横线。
  --user USER          Mieru 用户名，不填则随机生成。
  --password PASSWORD  Mieru 密码，不填则随机生成。
  --reinstall          已有 Mieru 时先卸载旧实例，再重新安装。
  --dry-run            只检查参数，不修改系统。
  -h, --help           查看帮助。

直接以 --port 开头的参数会被当作安装命令处理。
EOF
}

say() { printf '[ou-mieru] %s\n' "$*"; }
warn() { printf '%s[ou-mieru] 警告：%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
die() { printf '%s[ou-mieru] 错误：%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }

cleanup() {
  if [[ -n "${WORK_DIR:-}" && -d "$WORK_DIR" ]]; then
    find "$WORK_DIR" -mindepth 1 -maxdepth 1 -type f -delete 2>/dev/null || true
    rmdir "$WORK_DIR" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_root() {
  [[ "${EUID}" -eq 0 ]] || die '请使用 root 运行本脚本（例如 sudo nobrand）。'
}

is_valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( "$1" >= 1025 && "$1" <= 65535 ))
}

is_safe_token() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

is_safe_host() {
  [[ "$1" =~ ^[A-Za-z0-9.-]+$ ]]
}

random_token() {
  local length="$1"
  (
    set +o pipefail
    tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$length"
  )
}

take_value() {
  local flag="$1"
  [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != --* ]] || die "$flag 需要提供值。"
}

parse_install_args() {
  while (($#)); do
    case "$1" in
      --port)
        take_value "$1" "${2:-}"; PORT="$2"; shift 2 ;;
      --entry-host)
        take_value "$1" "${2:-}"; ENTRY_HOST="$2"; shift 2 ;;
      --entry-port)
        take_value "$1" "${2:-}"; ENTRY_PORT="$2"; shift 2 ;;
      --name)
        take_value "$1" "${2:-}"; NODE_NAME="$2"; shift 2 ;;
      --user)
        take_value "$1" "${2:-}"; PROXY_USER="$2"; shift 2 ;;
      --password)
        take_value "$1" "${2:-}"; PROXY_PASSWORD="$2"; shift 2 ;;
      --reinstall)
        REINSTALL=1; shift ;;
      --dry-run)
        DRY_RUN=1; shift ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        die "未知的安装选项：$1" ;;
    esac
  done

  [[ -n "$PORT" ]] || die '--port 为必填项。'
  [[ -n "$ENTRY_HOST" ]] || die '--entry-host 为必填项。'
  is_valid_port "$PORT" || die '--port 必须是 1025 到 65535 之间的整数。'
  is_safe_host "$ENTRY_HOST" || die '--entry-host 必须是 IPv4 地址或域名。'

  ENTRY_PORT="${ENTRY_PORT:-$PORT}"
  is_valid_port "$ENTRY_PORT" || die '--entry-port 必须是 1025 到 65535 之间的整数。'
  is_safe_token "$NODE_NAME" || die '--name 只能包含字母、数字、点、下划线和短横线。'

  PROXY_USER="${PROXY_USER:-$(random_token 12)}"
  PROXY_PASSWORD="${PROXY_PASSWORD:-$(random_token 18)}"
  is_safe_token "$PROXY_USER" || die '--user 含有不支持的字符。'
  is_safe_token "$PROXY_PASSWORD" || die '--password 含有不支持的字符。'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "缺少必要命令：$1"
}

validate_host() {
  [[ -r /etc/os-release ]] || die '无法识别操作系统。'
  # shellcheck disable=SC1091
  . /etc/os-release
  case "${ID:-}" in
    debian|ubuntu) ;;
    *) die "不支持的操作系统：${PRETTY_NAME:-未知}。本脚本支持 Debian 和 Ubuntu。" ;;
  esac

  require_command curl
  require_command sha256sum
  require_command ip
  require_command ss
  require_command dpkg
  require_command dpkg-query
  require_command apt-get
  require_command systemctl
}

apt_get() {
  DEBIAN_FRONTEND=noninteractive apt-get \
    -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT}" \
    -y "$@"
}

detect_network() {
  local default_iface public_ip private_ifaces
  default_iface="$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')"
  public_ip="$(ip -4 -o addr show dev "$default_iface" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')"
  private_ifaces="$(ip -4 -o addr show scope global 2>/dev/null | awk -v d="$default_iface" '$2 != d {print $2}' | sort -u | tr '\n' ' ')"
  DETECTED_DEFAULT_IFACE="$default_iface"
  DETECTED_PUBLIC_IP="$public_ip"
  DETECTED_PRIVATE_INTERFACES="$private_ifaces"
  NETWORK_DETECTED=1

  say "已识别公网出口网卡：${default_iface:-未知}（${public_ip:-未知}）"
  [[ -z "$private_ifaces" ]] || say "其他 IPv4 网卡：${private_ifaces% }"
}

check_port() {
  if ss -H -lnt "sport = :$PORT" | grep -q .; then
    die "TCP 端口 $PORT 已被占用，请从面板可用端口范围中选择其他端口。"
  fi
}

install_mieru() {
  WORK_DIR="$(mktemp -d /tmp/ou-mieru.XXXXXX)"
  local package architecture checksum package_url
  architecture="$(dpkg --print-architecture)"
  case "$architecture" in
    amd64)
      package="mita_${MIERU_VERSION#v}_amd64.deb"
      checksum="$MIERU_AMD64_SHA256"
      ;;
    arm64)
      package="mita_${MIERU_VERSION#v}_arm64.deb"
      checksum="$MIERU_ARM64_SHA256"
      ;;
    *)
      die "不支持的 CPU 架构：$architecture。本脚本支持 amd64 和 arm64。"
      ;;
  esac
  package_url="${MIERU_RELEASE_URL}/${package}"

  say "正在下载并校验 Mieru 官方运行时 ${MIERU_VERSION}。"
  curl --fail --location --silent --show-error "$package_url" -o "$WORK_DIR/$package"
  printf '%s  %s\n' "$checksum" "$WORK_DIR/$package" | sha256sum --check --status || die 'Mieru 安装包校验失败，已停止。'

  if dpkg-query -W -f='${db:Status-Abbrev}' mita 2>/dev/null | grep -q '^ii'; then
    PACKAGE_OWNED=0
    say "软件包管理器繁忙时将等待，最长 ${APT_LOCK_TIMEOUT} 秒。"
    apt_get install --reinstall "$WORK_DIR/$package" || die 'Mieru 软件包升级失败，请稍后重新运行脚本。'
  else
    PACKAGE_OWNED=1
    say "软件包管理器繁忙时将等待，最长 ${APT_LOCK_TIMEOUT} 秒。"
    apt_get install "$WORK_DIR/$package" || die 'Mieru 软件包安装失败，请稍后重新运行脚本。'
  fi

  require_command mita
  say "正在写入 Mieru 配置，监听 TCP ${PORT}，客户端入口为 ${ENTRY_HOST}:${ENTRY_PORT}。"
  install -d -m 0755 "$STATE_DIR"
  install -m 0600 /dev/stdin "$CONFIG_FILE" <<EOF
{
  "portBindings": [{"port": $PORT, "protocol": "TCP"}],
  "users": [{"name": "$PROXY_USER", "password": "$PROXY_PASSWORD"}],
  "mtu": 1400
}
EOF
  systemctl enable --now mita.service >/dev/null 2>&1 || die 'Mieru 服务启动失败。'
  mita apply config "$CONFIG_FILE" >/dev/null || die 'Mieru 配置写入失败。'
  mita start >/dev/null || die 'Mieru 代理启动失败。'
}

prepare_existing_install() {
  local existing=0
  command -v mita >/dev/null 2>&1 && existing=1
  dpkg-query -W -f='${db:Status-Abbrev}' mita 2>/dev/null | grep -q '^ii' && existing=1
  (( existing )) || return 0

    (( REINSTALL )) || die '检测到 Mieru 已安装；如需覆盖安装，请重新运行并加入 --reinstall。'
    if (( INTERACTIVE_INSTALL )); then
      printf '%s检测到已有 Mieru。将先卸载旧实例及其配置，再安装新实例。继续吗？[y/N] %s' "$C_YELLOW" "$C_RESET"
      local answer
      read -r answer
      [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]] || { say '已取消。'; return 1; }
    else
      say '检测到已有 Mieru，正在按 --reinstall 要求卸载旧实例。'
    fi
    if dpkg-query -W -f='${db:Status-Abbrev}' mita 2>/dev/null | grep -q '^ii'; then
      say "正在等待软件包管理器并卸载旧 Mieru，最长等待 ${APT_LOCK_TIMEOUT} 秒。"
      apt_get remove mita || die '卸载旧 Mieru 软件包失败，旧部署信息仍保留，请稍后重试。'
    else
      systemctl disable --now mita.service >/dev/null 2>&1 || true
    fi
    rm -f /usr/local/bin/install-mita /usr/local/bin/mita-menu /usr/local/bin/mita /usr/local/bin/mita-real
    rm -f /etc/mita/server.conf.pb
  return 0
}

install_shortcut() {
  [[ -r "$SELF_PATH" ]] || die "无法读取当前脚本（$SELF_PATH），请先下载后再运行 sudo bash ./nobrand。"
  if [[ -e "$SHORTCUT_PATH" || -L "$SHORTCUT_PATH" ]]; then
    local existing_target
    existing_target="$(readlink -f "$SHORTCUT_PATH" 2>/dev/null || true)"
    [[ "$existing_target" == "${INSTALL_DIR}/nobrand" ]] || die "$SHORTCUT_PATH 已存在且不是由 Ou-Mieru 管理。"
  fi
  install -D -m 0755 "$SELF_PATH" "${INSTALL_DIR}/nobrand"
  [[ -L "$SHORTCUT_PATH" ]] || ln -s "${INSTALL_DIR}/nobrand" "$SHORTCUT_PATH"
}

check_shortcut_path() {
  if [[ -e "$SHORTCUT_PATH" || -L "$SHORTCUT_PATH" ]]; then
    local existing_target
    existing_target="$(readlink -f "$SHORTCUT_PATH" 2>/dev/null || true)"
    [[ "$existing_target" == "${INSTALL_DIR}/nobrand" ]] || die "$SHORTCUT_PATH 已存在且不是由 Ou-Mieru 管理。"
  fi
}

write_state() {
  install -D -m 0600 /dev/stdin "$STATE_FILE" <<EOF
PORT=$PORT
ENTRY_HOST=$ENTRY_HOST
ENTRY_PORT=$ENTRY_PORT
NODE_NAME=$NODE_NAME
PROXY_USER=$PROXY_USER
PROXY_PASSWORD=$PROXY_PASSWORD
PACKAGE_OWNED=$PACKAGE_OWNED
EOF
}

load_state() {
  [[ -r "$STATE_FILE" ]] || die '本机没有找到 Ou-Mieru 部署信息。'
  # State values are written by this script after strict token validation.
  # shellcheck disable=SC1090
  . "$STATE_FILE"
}

mieru_uri() {
  printf 'mierus://%s:%s@%s:%s/?transport=TCP&mtu=1400&multiplexing=MULTIPLEXING_OFF#%s\n' \
    "$PROXY_USER" "$PROXY_PASSWORD" "$ENTRY_HOST" "$ENTRY_PORT" "$NODE_NAME"
}

print_protocol() {
  cat <<EOF

Mieru 协议链接：
$(mieru_uri)

通用 YAML 配置：
proxies:
  - name: $NODE_NAME
    type: mieru
    server: $ENTRY_HOST
    port: $ENTRY_PORT
    transport: TCP
    udp: true
    username: $PROXY_USER
    password: $PROXY_PASSWORD
    multiplexing: MULTIPLEXING_OFF
    mtu: 1400
EOF
}

verify() {
  local status=0 _
  say '正在验收：'
  for _ in {1..10}; do
    ss -H -lnt "sport = :$PORT" | grep -q . && break
    sleep 1
  done
  if ss -H -lnt "sport = :$PORT" | grep -q .; then
    say "  通过：Mieru 正在监听 TCP $PORT。"
  else
    warn "Mieru 没有监听 TCP $PORT。"
    status=1
  fi
  mita status || status=1
  return "$status"
}

run_install() {
  parse_install_args "$@"
  require_root
  validate_host
  ((NETWORK_DETECTED)) || detect_network

  if ((DRY_RUN)); then
    say "演练模式：将安装监听 TCP $PORT、入口为 $ENTRY_HOST:$ENTRY_PORT 的 Mieru。"
    return 0
  fi

  prepare_existing_install || return 0
  check_port
  check_shortcut_path

  install_mieru
  install_shortcut
  write_state
  verify
  banner
  print_protocol
  say '再次查看协议请运行：nobrand show。'
  say "请确认服务商 L4 入口（$ENTRY_HOST:$ENTRY_PORT）已转发到本机。"
}

show_protocol() {
  require_root
  load_state
  banner
  print_protocol
  if command -v mita >/dev/null 2>&1; then
    mita status || true
  else
    warn '未检测到 Mieru 运行时，但 Ou-Mieru 的部署信息仍保留。'
  fi
}

remove_path() {
  [[ -e "$1" || -L "$1" ]] && unlink "$1"
}

run_uninstall() {
  local assume_yes=0
  [[ "${1:-}" != '--yes' ]] || assume_yes=1
  require_root
  load_state

  if (( ! assume_yes )); then
    banner
    printf '将卸载 Mieru，并删除 Ou-Mieru 管理的文件。继续吗？[y/N] '
    local answer
    read -r answer
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]] || { say '已取消。'; return 0; }
  fi

  if command -v mita >/dev/null 2>&1; then
    systemctl disable --now mita.service >/dev/null 2>&1 || true
  fi
  if [[ "${PACKAGE_OWNED:-0}" == 1 ]] && dpkg-query -W -f='${db:Status-Abbrev}' mita 2>/dev/null | grep -q '^ii'; then
    say "正在等待软件包管理器并卸载 Mieru，最长等待 ${APT_LOCK_TIMEOUT} 秒。"
    apt_get remove mita || die 'Mieru 软件包卸载失败，Ou-Mieru 部署信息仍保留，请稍后重试。'
    remove_path /etc/mita/server.conf.pb
  fi

  remove_path "$STATE_FILE"
  remove_path "$CONFIG_FILE"
  remove_path "$SHORTCUT_PATH"
  remove_path "${INSTALL_DIR}/nobrand"
  rmdir "$STATE_DIR" 2>/dev/null || true
  rmdir "$INSTALL_DIR" 2>/dev/null || true

  say '已卸载 Mieru 并删除 Ou-Mieru 管理的文件。'
}

interactive_install() {
  local port entry_host entry_port node_name
  local -a install_args
  INTERACTIVE_INSTALL=1
  detect_network
  printf '\n%s请打开 Nobrand 控制台的"详情"区域，按下面的字段填写。%s\n\n' "$C_CYAN" "$C_RESET"
  printf '%s脚本已自动识别：%s\n' "$C_GREEN" "$C_RESET"
  printf '    日本 VPS 公网 IPv4：%s\n' "${DETECTED_PUBLIC_IP:-未识别}"
  printf '    默认网卡：%s\n' "${DETECTED_DEFAULT_IFACE:-未识别}"
  printf '    其他 IPv4 网卡：%s\n\n' "${DETECTED_PRIVATE_INTERFACES:-无}"

  while :; do
    read -r -p '第 1 步，填写选择的 Mieru 端口【专线网卡 · 可用端口范围】：' port
    is_valid_port "$port" && break
    printf '端口必须是 1025 到 65535 的整数。\n' >&2
  done
  while :; do
    read -r -p '第 2 步，填写移动入口【专线网卡 · 移动入口 (China Mobile)；不要填写外部连接 IP】：' entry_host
    is_safe_host "$entry_host" && break
    printf '请输入 IPv4 地址或域名，不能包含空格。\n' >&2
  done
  read -r -p "第 3 步，填写入口端口 [${port}]（外部入口端口；无特殊需求可直接回车）：" entry_port
  read -r -p '节点名称 [ou-mieru]：' node_name
  install_args=(--port "$port" --entry-host "$entry_host" --reinstall)
  [[ -z "$entry_port" ]] || install_args+=(--entry-port "$entry_port")
  [[ -z "$node_name" ]] || install_args+=(--name "$node_name")
  run_install "${install_args[@]}"
}

menu() {
  require_root
  banner
  printf '%s  1) 安装Mieru协议%s\n' "$C_GREEN" "$C_RESET"
  printf '  2) 查看 Mieru 协议\n'
  printf '  3) 一键卸载\n'
  printf '  0) 退出\n'
  printf '\n%s请选择 [0-3]：%s' "$C_CYAN" "$C_RESET"
  local selection
  read -r selection
  case "$selection" in
    1) interactive_install ;;
    2) show_protocol ;;
    3) run_uninstall ;;
    0) exit 0 ;;
    *) die '无效的选项。' ;;
  esac
}

main() {
  case "${1:-menu}" in
    menu)
      shift || true; menu ;;
    install)
      shift; run_install "$@" ;;
    show)
      shift; (($# == 0)) || die 'show 不接受额外选项。'; show_protocol ;;
    uninstall)
      shift; (($# == 0 || ($# == 1 && "$1" == '--yes'))) || die '请使用 uninstall 或 uninstall --yes。'; run_uninstall "${1:-}" ;;
    -h|--help|help)
      banner; usage ;;
    --*)
      run_install "$@" ;;
    *)
      die "未知命令：$1" ;;
  esac
}

main "$@"
